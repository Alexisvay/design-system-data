{
  "meta": {
    "name": "Button",
    "type": "composed",
    "role": "button",
    "description": "Déclenche une action qui modifie l'état du système. À préférer au lien quand on agit\n(enregistrer, supprimer), pas quand on navigue. Icon-only réservé aux actions dont\nl'icône est universelle."
  },
  "api": {
    "props": {
      "show-icon-left": {
        "type": "boolean",
        "default": true
      },
      "show-icon-right": {
        "type": "boolean",
        "default": false
      },
      "state": {
        "type": "enum",
        "enum": [
          "enabled",
          "hover",
          "focus",
          "press",
          "disabled"
        ],
        "default": "enabled",
        "runtime": {
          "hover": ":hover",
          "focus": ":focus-visible",
          "press": ":active",
          "disabled": "attribute:disabled"
        }
      },
      "size": {
        "type": "enum",
        "enum": [
          "md",
          "xs",
          "sm",
          "lg"
        ],
        "default": "xs"
      },
      "hierarchy": {
        "type": "enum",
        "enum": [
          "primary",
          "secondary",
          "tertiary"
        ],
        "default": "primary"
      },
      "tone": {
        "type": "enum",
        "enum": [
          "brand",
          "neutral",
          "error"
        ],
        "default": "brand"
      },
      "type": {
        "type": "enum",
        "enum": [
          "default",
          "icon-only"
        ],
        "default": "default"
      }
    }
  },
  "platforms": [
    "web",
    "ios",
    "android"
  ],
  "structure": {
    "slots": {
      "icon-left": {
        "accepts": "Instance",
        "default": {
          "swap": "placeholder"
        }
      },
      "icon-right": {
        "accepts": "Instance",
        "default": {
          "swap": "placeholder"
        }
      }
    },
    "children": [
      {
        "component": "placeholder",
        "name": "icon-left",
        "props": {
          "size": "16px"
        }
      },
      {
        "component": "placeholder",
        "name": "icon-right",
        "props": {
          "size": "16px"
        }
      }
    ],
    "uses": [
      "placeholder"
    ],
    "trees": [
      {
        "when": {
          "type": "default"
        },
        "tree": [
          {
            "name": "icon-left",
            "type": "instance",
            "component": "placeholder"
          },
          {
            "name": "button-label",
            "type": "text"
          },
          {
            "name": "icon-right",
            "hidden": true,
            "type": "instance",
            "component": "placeholder"
          }
        ]
      },
      {
        "when": {
          "type": "icon-only"
        },
        "tree": [
          {
            "name": "icon-left",
            "type": "instance",
            "component": "placeholder"
          }
        ]
      }
    ]
  },
  "styles": {
    "precedence": [
      "hierarchy",
      "tone",
      "type",
      "size",
      "state",
      "show-icon-left",
      "show-icon-right"
    ],
    "default": {
      "root": {
        "background": {
          "token": "color/bg/brand/mid/enabled"
        },
        "radius": 8,
        "padding": {
          "top": 4,
          "right": 4,
          "bottom": 4,
          "left": 4
        },
        "gap": 2,
        "layout": {
          "direction": "row",
          "mainAlign": "center",
          "crossAlign": "center",
          "sizingH": "hug",
          "sizingV": "hug"
        }
      },
      "label": {
